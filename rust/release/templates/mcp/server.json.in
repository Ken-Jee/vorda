{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Ken-Jee/vorda",
  "title": "vorda",
  "description": "Private vulnerability mailbox: scan deps, OS, browsers and MCP servers; read and ack alerts.",
  "repository": {
    "url": "@REPO_URL@",
    "source": "github"
  },
  "version": "@VERSION@",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "vorda",
      "version": "@VERSION@",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
